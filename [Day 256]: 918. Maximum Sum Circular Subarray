class Solution:
    def maxSubarraySumCircular(self, nums: List[int]) -> int:
        total = sum(nums)

        # Normal Kadane
        current = 0
        normal_max = float('-inf')

        for x in nums:
            current += x
            normal_max = max(normal_max, current)
            if current < 0:
                current = 0

        # All numbers are negative
        if normal_max < 0:
            return normal_max

        # Kadane on negated array
        neg = [-x for x in nums]

        current = 0
        maxi = float('-inf')

        for x in neg:
            current += x
            maxi = max(maxi, current)
            if current < 0:
                current = 0

        min_subarray = -maxi
        circular_max = total - min_subarray

        return max(normal_max, circular_max)
