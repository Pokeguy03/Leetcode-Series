class Solution:
    def removeDuplicateLetters(self, s: str) -> str:
        count=Counter(s)
        seen=set()
        stack=[]
        for i in s:
            count[i]-=1
            if i in seen:
                continue
            while stack and i<stack[-1] and count[stack[-1]]>0:
                seen.remove(stack.pop())
            seen.add(i)
            stack.append(i)
        return "".join(stack)
   
