class Solution:
    def canThreePartsEqualSum(self, arr: List[int]) -> bool:
        total=sum(arr)
        if total%3!=0:
            return False
        target=total//3
        count=0
        prefix_sum=0
        for i in arr:
            prefix_sum+=i
            if prefix_sum==target:
                count+=1
                prefix_sum=0
        return count>=3
        
